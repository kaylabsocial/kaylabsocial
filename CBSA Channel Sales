SELECT --i.cns_fips_tract_cd as Census_Tract, prch_str_nbr,
dd.amc_year, dd.amc_period, dd.amc_quarter, cns.cbsa_nm, CASE WHEN prch_str_nbr in (129,130,139) THEN 'Online' ELSE 'Store' END as Channel, prch_str_nbr , 
case 
      when m.fin_divn_nbr in (77) or PARENT_DIV_ID in (71,72,75,76,90) then 'Backstage'
      when prch_str_nbr in (130) or PARENT_DIV_ID in (66)  then 'Marketplace'
      when PARENT_DIV_ID in (15,10,18,12) then 'C.Core'
      when PARENT_DIV_ID in (19,14,17) then 'Beauty'
      when Parent_div_id in (44) then 'BigTicket'
      when parent_div_id in (52) then 'Kids'
      when parent_div_id in (62) then 'Leased'
      when parent_div_id in (50) then 'Mens'
      when parent_div_id in (47,60,53,70,46,48,41,59,65,69,10006,0,66) then 'Other'
      when parent_div_id in (23,24,29,26,13,25,22) then 'RTW'
      when parent_div_id in (43) then 'Soft Home'
      when m.dept_nbr in (3) then 'GOB'
      else 'Other' 
    end as FOB_category,
  SUM(m.rdsfin_rps_netnet_prch_amt) as Sales
  FROM `mtech-daas-transact-sdata.rfnd_sls.merch_all` AS m
LEFT JOIN `mtech-daas-customer-sdata.rfnd_cust.individual` AS i
ON m.indiv_id = i.indiv_id   AND m.fin_divn_nbr = i.fin_divn_nbr
LEFT JOIN `mtech-daas-reference-pdata.rfnd_ref_v.DATE_DIM_V` dd on m.txn_dt = dd.greg_date
left join `mtech-daas-product-pdata.rfnd_prod_v.MCH_HIER_V` mch 
    on case when m.fin_divn_nbr = 71 then 12 end = mch.divn_nbr 
   and m.DEPT_NBR = mch.DEPT_NBR
LEFT JOIN `mtech-daas-customer-pdata.trst_cust_mcy_v.cns_tracts_geo_unit_summ_snap_v` cns on  safe_cast(i.cns_fips_tract_cd as int) = cns.Tract_ID
WHERE m.fin_divn_nbr = 71
and dd.amc_year in (2025,2024,2023)
and cbsa_nm in ('Washington-Arlington-Alexandria, DC-VA-MD-WV Metropolitan Statistical Area','Boston-Cambridge-Newton, MA-NH Metropolitan Statistical Area','Dallas-Fort Worth-Arlington, TX Metropolitan Statistical Area','Atlanta-Sandy Springs-Roswell, GA Metropolitan Statistical Area','Philadelphia-Camden-Wilmington, PA-NJ-DE-MD Metropolitan Statistical Area')
/*and amc_day_of_year <= (select max(amc_day_of_year) from `mtech-daas-reference-pdata.rfnd_ref_v.DATE_DIM_V` WHERE week_cnt = -1)*/
and (safe_cast(m.dept_nbr as int) in (0,5,15,19,36,37,40,46) or safe_cast(m.dept_nbr as int) > 49)
GROUP BY 1,2,3,4,5,6,7
order by 1,2,3,4
